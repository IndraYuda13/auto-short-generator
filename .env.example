# Auto Short Generator Environment Configuration

# 9router local proxy endpoint (Port 20128)
ROUTER_BASE_URL=http://127.0.0.1:20128/v1
ROUTER_API_KEY=your_9router_api_key_here
LLM_MODEL=gemini/gemini-3.8-flash

# YouTube Data API v3 Key (Optional, fallback to yt-dlp & RSS if empty)
YOUTUBE_API_KEY=

# Search / Discovery Configuration
# Comma-separated search topics or channel IDs
SEARCH_QUERIES=podcast viral indonesia,deddy corbuzier podcast,raditya dika podcast,stand up comedy indonesia,curhat bang denny sumargo
MAX_SEARCH_RESULTS=5

# Target platform: youtube, tiktok, both, or none (local_only)
TARGET_PLATFORMS=youtube,tiktok

# Paths & Directories
PROJECT_ROOT=/root/projects/auto-short-generator
COOKIES_FILE=/root/projects/auto-short-generator/cookies.txt
DB_PATH=/root/projects/auto-short-generator/data/app.db
DOWNLOAD_DIR=/root/projects/auto-short-generator/downloads
OUTPUT_DIR=/root/projects/auto-short-generator/output

# Continuous Daemon Loop Settings
# Interval in seconds between full cycles (e.g. 1800 = 30 minutes, 300 = 5 minutes)
LOOP_INTERVAL_SECONDS=300

# Video Clip Requirements
MIN_CLIP_DURATION_SEC=30
MAX_CLIP_DURATION_SEC=55

# Whisper ASR model for fallback audio transcription (tiny, base, small, medium)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# YouTube OAuth Credentials Path (Optional if only testing/local)
YOUTUBE_CLIENT_SECRETS_FILE=/root/projects/auto-short-generator/client_secrets.json
YOUTUBE_CREDENTIALS_FILE=/root/projects/auto-short-generator/data/youtube_token.json

# TikTok Content Posting API v2 (Optional)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
