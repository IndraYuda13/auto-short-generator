[Unit]
Description=Auto Short Generator Web Dashboard (Port 8450)
After=network.target
StartLimitIntervalSec=120s
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/auto-short-generator
EnvironmentFile=-/root/projects/auto-short-generator/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/root/projects/auto-short-generator
Environment=PATH=/usr/local/lib/hermes-agent/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/lib/hermes-agent/venv/bin/python3 -m uvicorn web.dashboard:app --host 0.0.0.0 --port 8450

Restart=always
RestartSec=3s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=autoshort-web

# Isolation & limits
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=/root/projects/auto-short-generator

[Install]
WantedBy=multi-user.target
